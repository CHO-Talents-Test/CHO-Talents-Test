# Copy this file to .env.local and fill in secrets locally.
# .env.local is ignored by git.

# GitHub source management
GITHUB_OWNER=CHO-Talents-Test
GITHUB_REPO=CHO-Talents-Test
GITHUB_BRANCH=develop
GITHUB_PAT=

# Service usage collector (Supabase Edge Function secrets)
# GitHub fine-grained token:
# - Personal account billing: account Plan(read)
# - Repository usage: repository Actions(read), Administration(read), Metadata(read)
GITHUB_TOKEN=
GITHUB_ACCOUNT_TYPE=user
SB_MANAGEMENT_ACCESS_TOKEN=
# Use the project ref from the Supabase dashboard URL.
SB_PROJECT_REF=
APP_ENV=DEV
SLACK_ENABLED=false
SERVICE_STATS_URL=https://cho-talents-test.github.io/CHO-Talents-Test/admin/service-stats.html

# Supabase public browser config
APP_CONFIG_ENV=DEV
SUPABASE_URL=https://blitrrcdkkkszvgylnus.supabase.co
SUPABASE_ANON_KEY=sb_publishable_TgsQePzjxca9Hr3Lh_dHvA_O1JqRAQ6
SUPABASE_AUTH_EMAIL_DOMAIN=@cho-talents.app

# Required only for unrestricted database CRUD or SQL automation.
# Never expose these values to browser code.
# For recurring log-translation operations, set the target environment and
# project reference as a guard against updating the wrong database.
LOG_TRANSLATION_TARGET_ENV=
LOG_TRANSLATION_PROJECT_REF=
# Preferred for server-side recurring log translation automation (sb_secret_...).
SUPABASE_SECRET_KEY=
# Legacy alternative only when a new secret key cannot be issued.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_CONNECTION_STRING=

# Browser-safe Kakao JavaScript key
KAKAO_MAP_KEY=0ef8925b28135eeac474bc411c456170

# Slack Edge Function secrets
# Store real webhook URLs in Supabase Edge Function secrets, not in browser JS.
SLACK_WEBHOOK_PART1=
SLACK_WEBHOOK_PART2=
SLACK_WEBHOOK_PART3=
SLACK_WEBHOOK_PART4=
SLACK_WEBHOOK_PART5=
SLACK_WEBHOOK_WORSHIP=
SLACK_WEBHOOK_PRODUCT_MANAGEMENT=
SLACK_WEBHOOK_OPERATIONS=
SLACK_WEBHOOK_ANSWER=
